# ==============================================================================
# The Receipt Graveyard — AI Expense Auditor & High-Accuracy OCR Platform
# Configuration Environment Variables
# ==============================================================================

# Core Application Settings
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Persistent Storage Paths (Essential for Cloud Containers like Render)
# RECEIPT_GRAVEYARD_DATA_DIR=/var/data
# DATABASE_PATH=/var/data/expenses.db
# UPLOAD_FOLDER=/var/data/uploads

# High-Accuracy OCR Engine Configuration
# Available options: paddleocr, tesseract, cloud_doc_ai, native_pdf
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=tesseract
OCR_MIN_CONFIDENCE=0.70
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MAX_PDF_PAGES=50
OCR_PROCESSING_TIMEOUT_SECONDS=120

# Optional Cloud Document AI Providers (Leave blank for 100% local operation)
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Drive Ingestion & Security
# Modes: public (link-sharing) or oauth / service_account
GOOGLE_DRIVE_AUTH_MODE=public
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_MAX_FILE_SIZE_MB=25
GOOGLE_DRIVE_DOWNLOAD_TIMEOUT_SECONDS=30

# Bulk Ingestion Concurrency & Task Batching
IMPORT_MAX_ROWS=1000
IMPORT_BATCH_SIZE=10
IMPORT_MAX_CONCURRENCY=2

# Default Financial & Policy Thresholds
DEFAULT_CURRENCY=INR
DEFAULT_LOCAL_MEAL_CAP=1200.0
DEFAULT_TRIP_MEAL_CAP=2200.0
DEFAULT_AUTO_APPROVAL_CAP=1500.0
DEFAULT_MANAGER_THRESHOLD=8000.0
DEFAULT_VP_THRESHOLD=20000.0
DEFAULT_EDITING_WINDOW_HOURS=24.0
ACTIVE_POLICY_VERSION=v2026.1
